---
import { render } from 'astro:content';
import Article from '../../layouts/Article.astro';
import { getPosts, getAllSeries } from '../../lib/content';

export async function getStaticPaths() {
  const [posts, allSeries] = await Promise.all([getPosts({ includeMargins: true }), getAllSeries()]);
  // Prev/next stay within the same shelf: margins with margins, everything else together.
  return posts.map((post) => {
    const shelf = posts.filter((p) => (p.data.section === 'margins') === (post.data.section === 'margins'));
    const i = shelf.findIndex((p) => p.id === post.id);
    const series = allSeries.find((s) => s.entry.id === post.data.series);
    return { params: { slug: post.id }, props: { post, newer: shelf[i - 1], older: shelf[i + 1], series } };
  });
}

const { post, newer, older, series } = Astro.props;
const { Content, headings } = await render(post);
---

<Article post={post} headings={headings} newer={newer} older={older} series={series}>
  <Content />
</Article>
