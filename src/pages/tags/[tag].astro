---
import Base from '../../layouts/Base.astro';
import PostRow from '../../components/PostRow.astro';
import { getPosts, slugify } from '../../lib/content';

export async function getStaticPaths() {
  const posts = await getPosts();
  const tags = new Map<string, string>();
  for (const p of posts) for (const t of p.data.tags) tags.set(slugify(t), t);
  return [...tags].map(([tag, label]) => ({
    params: { tag },
    props: { label, posts: posts.filter((p) => p.data.tags.some((t) => slugify(t) === tag)) },
  }));
}

const { label, posts } = Astro.props;
---

<Base title={`Tagged “${label}”`}>
  <div class="wrap">
    <div class="page-head">
      <div class="crumbs"><a href="/writing/">Writing</a> / Tags</div>
      <h1>{label}</h1>
      <p>{posts.length} {posts.length === 1 ? 'article' : 'articles'}</p>
    </div>
    <div style="padding-bottom:64px">{posts.map((p) => <PostRow post={p} />)}</div>
  </div>
</Base>
