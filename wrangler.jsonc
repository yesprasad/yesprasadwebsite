// Cloudflare deploy config. The site is fully static: `npm run build` writes to dist/
// and Wrangler uploads it as-is. Keeping this file stops Wrangler from trying to
// auto-configure the project with `astro add cloudflare` on every deploy.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "yesprasad", // must match the Worker name in the Cloudflare dashboard
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  }
}
