---
import { render } from 'astro:content';
import Article from '../../layouts/Article.astro';
import { getPosts } from '../../lib/content';

export async function getStaticPaths() {
  const posts = await getPosts({ includeMargins: true });
  // Prev/next stay within the same shelf: margins with margins, everything else together.
  return posts.map((post) => {
    const shelf = posts.filter((p) => (p.data.section === 'margins') === (post.data.section === 'margins'));
    const i = shelf.findIndex((p) => p.id === post.id);
    return { params: { slug: post.id }, props: { post, newer: shelf[i - 1], older: shelf[i + 1] } };
  });
}

const { post, newer, older } = Astro.props;
const { Content, headings } = await render(post);
---

<Article post={post} headings={headings} newer={newer} older={older}>
  <Content />
</Article>
